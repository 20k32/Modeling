<?xml version="1.0" encoding="utf-8" ?>
<UserControl x:Class="Modeling.UI.Resources.Controls.Miscellaneous.IncrementingTextBox.IncrementingTextBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             PointerWheelChanged="OnIncrementingTextBoxPointerWheelChanged"
             xmlns:local="using:Modeling.UI.Resources.Controls.Miscellaneous.IncrementingTextBox"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <Grid HorizontalAlignment="Center"
          VerticalAlignment="Center"
          ColumnSpacing="3">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <TextBox x:Name="IncrementingBox"
                 Width="10"
                 GotFocus="OnIncrementingTextBoxGotFocus"
                 LostFocus="OnIncrementingBoxLostFocus"
                 Style="{StaticResource ApplicationTextBoxStyle}"
                 TextChanged="OnIncrementingTextBoxTextBoxTextChanged" />

        <RepeatButton Grid.Column="1"
                      Width="30"
                      Height="30"
                      Padding="0"
                      HorizontalContentAlignment="Center"
                      VerticalContentAlignment="Center"
                      Command="{x:Bind DecreaseValueCommand}"
                      Content="-"
                      Visibility="{x:Bind InCompactMode, Converter={StaticResource CommunityToolkit.BoolToVisibilityConverter}, ConverterParameter=True, Mode=OneWay}" />

        <RepeatButton Grid.Column="2"
                      Width="30"
                      Height="30"
                      Padding="0"
                      HorizontalContentAlignment="Center"
                      VerticalContentAlignment="Center"
                      Command="{x:Bind IncreaseValueCommand}"
                      Content="+"
                      Visibility="{x:Bind InCompactMode, Converter={StaticResource CommunityToolkit.BoolToVisibilityConverter}, ConverterParameter=True, Mode=OneWay}" />

        <Grid Grid.Column="1"
              Height="30"
              ColumnSpacing="0"
              RowSpacing="0"
              UseLayoutRounding="False"
              Visibility="{x:Bind InCompactMode, Mode=OneWay}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <RepeatButton Grid.Row="0"
                          Width="30"
                          Padding="0"
                          VerticalAlignment="Stretch"
                          HorizontalContentAlignment="Center"
                          VerticalContentAlignment="Center"
                          Command="{x:Bind DecreaseValueCommand}"
                          CornerRadius="4,4,0,0">
                <RepeatButton.Content>
                    <TextBlock Margin="0,-3,0,0"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Text="-" />
                </RepeatButton.Content>
            </RepeatButton>

            <RepeatButton Grid.Row="1"
                          Width="30"
                          Padding="0"
                          VerticalAlignment="Stretch"
                          HorizontalContentAlignment="Center"
                          VerticalContentAlignment="Center"
                          Command="{x:Bind IncreaseValueCommand}"
                          CornerRadius="0,0,4,4">
                <RepeatButton.Content>
                    <TextBlock Margin="0,-3,0,0"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Text="+" />
                </RepeatButton.Content>
            </RepeatButton>
        </Grid>
    </Grid>
</UserControl>
