<?xml version="1.0" encoding="utf-8" ?>
<UserControl x:Class="Modeling.UI.Resources.Controls.Pages.ResizingPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="using:Modeling.UI.Resources.Controls.Pages"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             DataContext="{Binding DrawingViewModel, Source={StaticResource ServiceLocator}}"
             mc:Ignorable="d">

    <Grid RowSpacing="20">
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
        </Grid.RowDefinitions>

        <ToggleButton Grid.Row="0"
                      Content="Pick a shape by mouse"
                      IsChecked="{Binding PickShapeForResizing, Mode=TwoWay}"
                      Visibility="{Binding AdditionalPanelVisible, Converter={StaticResource CommunityToolkit.BoolToVisibilityConverter}, ConverterParameter=True}" />
        <ToggleButton Grid.Row="1"
                      Content="Change figure position"
                      IsChecked="{Binding ChangeFigurePosition, Mode=TwoWay}"
                      Visibility="{Binding AdditionalPanelVisible, Converter={StaticResource CommunityToolkit.BoolToVisibilityConverter}, ConverterParameter=True}" />

        <Button Grid.Row="2"
                HorizontalAlignment="Stretch"
                Command="{Binding ResetFigureCommand}"
                Content="Reset Figure"
                Visibility="{Binding AdditionalPanelVisible, Converter={StaticResource CommunityToolkit.BoolToVisibilityConverter}, ConverterParameter=True}" />

        <TextBlock Grid.Row="0" Visibility="{Binding AdditionalPanelVisible}">
            <TextBlock.Inlines>
                <Run Text="You have picked:" />
                <Run Text="{Binding NearestSegment.GeometryType}" />
            </TextBlock.Inlines>
        </TextBlock>

        <TextBox Grid.Row="1"
                 Text="{Binding DimensionLength, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                 Visibility="{Binding AdditionalPanelVisible}">
            <TextBox.Header>
                <TextBlock>
                    <Run Text="{Binding NearestSegment.DimensionType}" /><Run Text=":" />
                </TextBlock>
            </TextBox.Header>
        </TextBox>

        <Button Grid.Row="2"
                HorizontalAlignment="Stretch"
                Command="{Binding CancelPickingShapeCommand}"
                Content="Cancel"
                Visibility="{Binding AdditionalPanelVisible}" />
    </Grid>
</UserControl>
