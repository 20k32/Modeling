<?xml version="1.0" encoding="utf-8" ?>
<UserControl x:Class="Modeling.UI.Resources.Controls.Pages.ResizingPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="using:Modeling.UI.Resources.Controls.Pages"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             DataContext="{Binding DrawingViewModel, Source={StaticResource ServiceLocator}}"
             mc:Ignorable="d">

    <Grid RowSpacing="20">
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
        </Grid.RowDefinitions>

        <ToggleButton Grid.Row="0"
                      Content="Pick a shape by mouse"
                      IsChecked="{Binding PickShapeForResizing, Mode=TwoWay}"
                      Visibility="{Binding PickButtonsVisible}" />
        <ToggleButton Grid.Row="1"
                      Content="Change figure position"
                      IsChecked="{Binding ChangeFigurePosition, Mode=TwoWay}"
                      Visibility="{Binding PickButtonsVisible}" />

        <!--  Size editing panel  -->
        <TextBlock Grid.Row="0" Visibility="{Binding SizeEditingPanelVisible}">
            <TextBlock.Inlines>
                <Run Text="You have picked:" />
                <Run Text="{Binding NearestSegment.GeometryType}" />
            </TextBlock.Inlines>
        </TextBlock>

        <TextBox Grid.Row="1"
                 Text="{Binding DimensionLengthCentimeters, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                 Visibility="{Binding SizeEditingPanelVisible}">
            <TextBox.Header>
                <TextBlock>
                    <Run Text="{Binding NearestSegment.DimensionType}" /><Run Text=", " /><Run Text="cm" /><Run Text=":" />
                </TextBlock>
            </TextBox.Header>
        </TextBox>


        <!--  Position editing panel  -->
        <CheckBox Grid.Row="0"
                  Content="Show rotation point"
                  IsChecked="{Binding RotationPointVisible}"
                  Visibility="{Binding PositionEditingPanelVisible}" />

        <Slider Grid.Row="1"
                Width="200"
                Header="Rotation angle (degrees):"
                Maximum="360"
                Minimum="0"
                StepFrequency="0.5"
                Visibility="{Binding PositionEditingPanelVisible}" />

        <ToggleButton Grid.Row="2"
                      HorizontalAlignment="Stretch"
                      Content="Change position"
                      IsChecked="{Binding PositionEditingControlVisible, Mode=TwoWay}"
                      Visibility="{Binding PositionEditingPanelVisible}" />

        <!--  Content for both panels  -->
        <Button Grid.Row="2"
                HorizontalAlignment="Stretch"
                Command="{Binding ResetFigureCommand}"
                Content="Reset Figure"
                Visibility="{Binding CancelButtonVisible, Converter={StaticResource CommunityToolkit.BoolToVisibilityConverter}, ConverterParameter=True}" />

        <Button Grid.Row="3"
                HorizontalAlignment="Stretch"
                Command="{Binding CancelPickingShapeCommand}"
                Content="Cancel"
                Visibility="{Binding CancelButtonVisible}" />
    </Grid>
</UserControl>
