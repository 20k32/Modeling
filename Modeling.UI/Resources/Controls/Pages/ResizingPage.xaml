<?xml version="1.0" encoding="utf-8" ?>
<UserControl x:Class="Modeling.UI.Resources.Controls.Pages.ResizingPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:incrementalControl="using:Modeling.UI.Resources.Controls.Miscellaneous.IncrementingTextBox"
             xmlns:local="using:Modeling.UI.Resources.Controls.Pages"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             DataContext="{Binding DrawingViewModel, Source={StaticResource ServiceLocator}}"
             mc:Ignorable="d">

    <Grid RowSpacing="20">
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
        </Grid.RowDefinitions>

        <ToggleButton Grid.Row="0"
                      Content="Pick a shape by mouse"
                      IsChecked="{Binding PickShapeForResizing, Mode=TwoWay}"
                      Visibility="{Binding PickButtonsVisible}" />
        <ToggleButton Grid.Row="1"
                      Content="Change figure position"
                      IsChecked="{Binding ChangeFigurePosition, Mode=TwoWay}"
                      Visibility="{Binding PickButtonsVisible}" />

        <!--  Size editing panel  -->
        <TextBlock Grid.Row="0" Visibility="{Binding SizeEditingPanelVisible}">
            <TextBlock.Inlines>
                <Run Text="You have picked:" />
                <Run Text="{Binding NearestSegment.GeometryType}" />
            </TextBlock.Inlines>
        </TextBlock>

        <TextBox Grid.Row="1"
                 Text="{Binding DimensionLengthCentimeters, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                 Visibility="{Binding SizeEditingPanelVisible}">
            <TextBox.Header>
                <TextBlock>
                    <Run Text="{Binding NearestSegment.DimensionType}" /><Run Text=", " /><Run Text="cm" /><Run Text=":" />
                </TextBlock>
            </TextBox.Header>
        </TextBox>


        <!--  Position editing panel  -->
        <CheckBox Grid.Row="0"
                  Content="Show rotation point"
                  IsChecked="{Binding RotationPointVisible, Mode=TwoWay}"
                  Visibility="{Binding PositionEditingPanelVisible}" />

        <Slider Grid.Row="1"
                Width="200"
                Maximum="360"
                Minimum="0"
                StepFrequency="{Binding UserInterfaceConstants.SlidersStepFrequency, Source={StaticResource ServiceLocator}}"
                Visibility="{Binding PositionEditingPanelVisible}"
                Value="{Binding RotationAngle, Mode=TwoWay}">
            <Slider.Header>
                <TextBlock>
                    <TextBlock.Inlines>
                        <Run Text="Rotation angle, degrees" />
                        <Run Text="{Binding RotationAngle}" />
                        <Run Text=":" />
                    </TextBlock.Inlines>

                </TextBlock>
            </Slider.Header>
        </Slider>

        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    Spacing="10"
                    Visibility="{Binding ChangeFigurePosition}">
            <TextBlock VerticalAlignment="Center" Text="X:" />
            <incrementalControl:IncrementingTextBox InCompactMode="True"
                                                    IncrementingValue="{Binding HorizontalRotationPointCenter, Mode=TwoWay}"
                                                    IsEnabled="{Binding RotationPointVisible}"
                                                    MaximumIncrementingValue="{Binding SettingsViewModel.CanvasWidth, Source={StaticResource ServiceLocator}}"
                                                    MinimumIncrementingValue="{Binding SettingsViewModel.CanvasWidth, Source={StaticResource ServiceLocator}, Converter={StaticResource InvertFloatConverter}}" />
            <TextBlock VerticalAlignment="Center" Text="Y:" />
            <incrementalControl:IncrementingTextBox InCompactMode="True"
                                                    IncrementingValue="{Binding VerticalRotationPointCenter, Mode=TwoWay}"
                                                    IsEnabled="{Binding RotationPointVisible}"
                                                    MaximumIncrementingValue="{Binding SettingsViewModel.CanvasHeight, Source={StaticResource ServiceLocator}}"
                                                    MinimumIncrementingValue="{Binding SettingsViewModel.CanvasHeight, Source={StaticResource ServiceLocator}, Converter={StaticResource InvertFloatConverter}}" />
            <Border Width="18"
                    Height="18"
                    Padding="0"
                    Background="LightGray"
                    CornerRadius="8"
                    ToolTipService.ToolTip="Coordinates of rotation point of figure">

                <PathIcon Margin="0,-1.3,0,0"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Center"
                          Data="{StaticResource QuestionIcon}"
                          Foreground="Black">
                    <PathIcon.RenderTransform>
                        <ScaleTransform ScaleX="0.8" ScaleY="0.8" />
                    </PathIcon.RenderTransform>
                </PathIcon>
            </Border>
        </StackPanel>
        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    Spacing="10"
                    Visibility="{Binding ChangeFigurePosition}">
            <TextBlock VerticalAlignment="Center" Text="X:" />
            <incrementalControl:IncrementingTextBox InCompactMode="True"
                                                    IncrementingValue="{Binding HorizontalFigurePosition, Mode=TwoWay}"
                                                    IsEnabled="{Binding PositionEditingControlVisible}"
                                                    MaximumIncrementingValue="{Binding SettingsViewModel.CanvasWidth, Source={StaticResource ServiceLocator}}"
                                                    MinimumIncrementingValue="{Binding SettingsViewModel.CanvasWidth, Source={StaticResource ServiceLocator}, Converter={StaticResource InvertFloatConverter}}" />
            <TextBlock VerticalAlignment="Center" Text="Y:" />
            <incrementalControl:IncrementingTextBox InCompactMode="True"
                                                    IncrementingValue="{Binding VerticalFigurePosition, Mode=TwoWay}"
                                                    IsEnabled="{Binding PositionEditingControlVisible}"
                                                    MaximumIncrementingValue="{Binding SettingsViewModel.CanvasHeight, Source={StaticResource ServiceLocator}}"
                                                    MinimumIncrementingValue="{Binding SettingsViewModel.CanvasHeight, Source={StaticResource ServiceLocator}, Converter={StaticResource InvertFloatConverter}}" />
            <Border Width="18"
                    Height="18"
                    Padding="0"
                    Background="LightGray"
                    CornerRadius="8"
                    ToolTipService.ToolTip="Coordinates of center of figure">

                <PathIcon Margin="0,-1.3,0,0"
                          Data="{StaticResource QuestionIcon}"
                          Foreground="Black">
                    <PathIcon.RenderTransform>
                        <ScaleTransform ScaleX="0.8" ScaleY="0.8" />
                    </PathIcon.RenderTransform>
                </PathIcon>
            </Border>
        </StackPanel>

        <Button Grid.Row="5"
                HorizontalAlignment="Stretch"
                Command="{Binding ApplySymmetryTransformCommand}"
                Content="Symmetry relative rotation point"
                Visibility="{Binding PositionEditingPanelVisible}" />

        <ToggleButton Grid.Row="6"
                      HorizontalAlignment="Stretch"
                      Content="Change position"
                      IsChecked="{Binding PositionEditingControlVisible, Mode=TwoWay}"
                      Visibility="{Binding PositionEditingPanelVisible}" />

        <ToggleButton Grid.Row="2"
                      HorizontalAlignment="Stretch"
                      Content="Animate rotation"
                      IsChecked="{Binding AnimateRotation, Mode=TwoWay}"
                      Visibility="{Binding PositionEditingPanelVisible}" />
        <!--  Content for both panels  -->
        <Button Grid.Row="2"
                HorizontalAlignment="Stretch"
                Command="{Binding ResetFigureCommand}"
                Content="Reset Figure"
                Visibility="{Binding CancelButtonVisible, Converter={StaticResource CommunityToolkit.BoolToVisibilityConverter}, ConverterParameter=True}" />

        <Button Grid.Row="7"
                HorizontalAlignment="Stretch"
                Command="{Binding CancelPickingShapeCommand}"
                Content="Cancel"
                Visibility="{Binding CancelButtonVisible}" />
    </Grid>
</UserControl>
