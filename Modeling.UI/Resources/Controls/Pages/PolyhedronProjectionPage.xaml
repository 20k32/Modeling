<?xml version="1.0" encoding="utf-8" ?>
<UserControl x:Class="Modeling.UI.Resources.Controls.Pages.PolyhedronProjectionPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:incrementingControl="using:Modeling.UI.Resources.Controls.Miscellaneous.IncrementingTextBox"
             xmlns:local="using:Modeling.UI.Resources.Controls.Pages"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             DataContext="{Binding DrawingViewModel, Source={StaticResource ServiceLocator}}"
             mc:Ignorable="d">

    <ScrollViewer HorizontalScrollMode="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Width="400"
                    Padding="0,0,15,15"
                    Spacing="10">

            <!--  Faceted solid  -->
            <TextBlock FontWeight="SemiBold"
                       Style="{StaticResource ApplicationTextBlockStyle}"
                       Text="Faceted solid: tower" />
            <TextBlock Text="Three point perspective on the plane x = 0:&#x0a;[x y z 1]·M,  w = 1 − x/xs − y/ys − z/zs,  point (y/w; z/w)" TextWrapping="Wrap" />
            <TextBlock Text="{Binding PolyhedronInfoText}" TextWrapping="Wrap" />
            <Grid ColumnSpacing="10" RowSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0"
                           Grid.Column="0"
                           VerticalAlignment="Center"
                           Text="Sides of the tower:" />
                <incrementingControl:IncrementingTextBox Grid.Row="0"
                                                         Grid.Column="1"
                                                         InCompactMode="False"
                                                         IncrementingStep="{Binding UserInterfaceConstants.LargeIncrementingStep, Source={StaticResource ServiceLocator}}"
                                                         IncrementingValue="{Binding PolyhedronSidesCount, Mode=TwoWay}"
                                                         MaximumIncrementingValue="{Binding MaximumPolyhedronSidesCount}"
                                                         MinimumIncrementingValue="{Binding MinimumPolyhedronSidesCount}" />
                <TextBlock Grid.Row="1"
                           Grid.Column="0"
                           VerticalAlignment="Center"
                           Text="Radius, cm:" />
                <incrementingControl:IncrementingTextBox Grid.Row="1"
                                                         Grid.Column="1"
                                                         InCompactMode="False"
                                                         IncrementingStep="{Binding UserInterfaceConstants.MediumIncrementingStep, Source={StaticResource ServiceLocator}}"
                                                         IncrementingValue="{Binding PolyhedronRadius, Mode=TwoWay}"
                                                         MaximumIncrementingValue="{Binding MaximumPolyhedronSize}"
                                                         MinimumIncrementingValue="{Binding MinimumPolyhedronSize}" />
                <TextBlock Grid.Row="2"
                           Grid.Column="0"
                           VerticalAlignment="Center"
                           Text="Body height, cm:" />
                <incrementingControl:IncrementingTextBox Grid.Row="2"
                                                         Grid.Column="1"
                                                         InCompactMode="False"
                                                         IncrementingStep="{Binding UserInterfaceConstants.MediumIncrementingStep, Source={StaticResource ServiceLocator}}"
                                                         IncrementingValue="{Binding PolyhedronHeight, Mode=TwoWay}"
                                                         MaximumIncrementingValue="{Binding MaximumPolyhedronSize}"
                                                         MinimumIncrementingValue="{Binding MinimumPolyhedronSize}" />
                <TextBlock Grid.Row="3"
                           Grid.Column="0"
                           VerticalAlignment="Center"
                           Text="Roof height, cm:" />
                <incrementingControl:IncrementingTextBox Grid.Row="3"
                                                         Grid.Column="1"
                                                         InCompactMode="False"
                                                         IncrementingStep="{Binding UserInterfaceConstants.MediumIncrementingStep, Source={StaticResource ServiceLocator}}"
                                                         IncrementingValue="{Binding PolyhedronRoofHeight, Mode=TwoWay}"
                                                         MaximumIncrementingValue="{Binding MaximumPolyhedronSize}"
                                                         MinimumIncrementingValue="{Binding MinimumPolyhedronSize}" />
                <TextBlock Grid.Row="4"
                           Grid.Column="0"
                           VerticalAlignment="Center"
                           Text="Scale:" />
                <incrementingControl:IncrementingTextBox Grid.Row="4"
                                                         Grid.Column="1"
                                                         InCompactMode="False"
                                                         IncrementingStep="{Binding UserInterfaceConstants.MediumIncrementingStep, Source={StaticResource ServiceLocator}}"
                                                         IncrementingValue="{Binding PolyhedronScale, Mode=TwoWay}"
                                                         MaximumIncrementingValue="{Binding MaximumPolyhedronScale}"
                                                         MinimumIncrementingValue="{Binding MinimumPolyhedronScale}" />
            </Grid>
            <Button HorizontalAlignment="Stretch"
                    Command="{Binding ResetFigureCommand}"
                    Content="Reset solid" />

            <!--  Euclidean transformations  -->
            <TextBlock FontWeight="SemiBold" Text="Euclidean transformations" />
            <TextBlock Text="Shift x; y; z, cm:" />
            <Grid ColumnSpacing="10" RowSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <incrementingControl:IncrementingTextBox Grid.Row="0"
                                                         Grid.Column="0"
                                                         InCompactMode="True"
                                                         IncrementingStep="{Binding UserInterfaceConstants.MediumIncrementingStep, Source={StaticResource ServiceLocator}}"
                                                         IncrementingValue="{Binding PolyhedronTranslationX, Mode=TwoWay}"
                                                         MaximumIncrementingValue="{Binding MaximumPolyhedronTranslation}"
                                                         MinimumIncrementingValue="{Binding MinimumPolyhedronTranslation}" />
                <incrementingControl:IncrementingTextBox Grid.Row="0"
                                                         Grid.Column="1"
                                                         InCompactMode="True"
                                                         IncrementingStep="{Binding UserInterfaceConstants.MediumIncrementingStep, Source={StaticResource ServiceLocator}}"
                                                         IncrementingValue="{Binding PolyhedronTranslationY, Mode=TwoWay}"
                                                         MaximumIncrementingValue="{Binding MaximumPolyhedronTranslation}"
                                                         MinimumIncrementingValue="{Binding MinimumPolyhedronTranslation}" />
                <incrementingControl:IncrementingTextBox Grid.Row="0"
                                                         Grid.Column="2"
                                                         InCompactMode="True"
                                                         IncrementingStep="{Binding UserInterfaceConstants.MediumIncrementingStep, Source={StaticResource ServiceLocator}}"
                                                         IncrementingValue="{Binding PolyhedronTranslationZ, Mode=TwoWay}"
                                                         MaximumIncrementingValue="{Binding MaximumPolyhedronTranslation}"
                                                         MinimumIncrementingValue="{Binding MinimumPolyhedronTranslation}" />
            </Grid>
            <Slider Maximum="180"
                    Minimum="-180"
                    StepFrequency="{Binding UserInterfaceConstants.SlidersStepFrequency, Source={StaticResource ServiceLocator}}"
                    Value="{Binding PolyhedronRotationX, Mode=TwoWay}">
                <Slider.Header>
                    <TextBlock>
                        <Run Text="Rotation around own axis X, degrees:" />
                        <Run Text="{Binding PolyhedronRotationX}" />
                    </TextBlock>
                </Slider.Header>
            </Slider>
            <Slider Maximum="180"
                    Minimum="-180"
                    StepFrequency="{Binding UserInterfaceConstants.SlidersStepFrequency, Source={StaticResource ServiceLocator}}"
                    Value="{Binding PolyhedronRotationY, Mode=TwoWay}">
                <Slider.Header>
                    <TextBlock>
                        <Run Text="Rotation around own axis Y, degrees:" />
                        <Run Text="{Binding PolyhedronRotationY}" />
                    </TextBlock>
                </Slider.Header>
            </Slider>
            <Slider Maximum="180"
                    Minimum="-180"
                    StepFrequency="{Binding UserInterfaceConstants.SlidersStepFrequency, Source={StaticResource ServiceLocator}}"
                    Value="{Binding PolyhedronRotationZ, Mode=TwoWay}">
                <Slider.Header>
                    <TextBlock>
                        <Run Text="Rotation around own axis Z, degrees:" />
                        <Run Text="{Binding PolyhedronRotationZ}" />
                    </TextBlock>
                </Slider.Header>
            </Slider>
            <TextBlock Text="{Binding PolyhedronPivotText}" TextWrapping="Wrap" />
            <CheckBox Content="Show own axes and center" IsChecked="{Binding PolyhedronOwnAxesVisible, Mode=TwoWay}" />
            <Button HorizontalAlignment="Stretch"
                    Command="{Binding ResetPolyhedronTransformsCommand}"
                    Content="Reset transformations" />

            <!--  Animation  -->
            <TextBlock FontWeight="SemiBold" Text="Animation (height and turn every frame)" />
            <TextBlock Text="Height from; to, cm:" />
            <Grid ColumnSpacing="10" RowSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <incrementingControl:IncrementingTextBox Grid.Row="0"
                                                         Grid.Column="0"
                                                         InCompactMode="True"
                                                         IncrementingStep="{Binding UserInterfaceConstants.MediumIncrementingStep, Source={StaticResource ServiceLocator}}"
                                                         IncrementingValue="{Binding PolyhedronAnimationHeightMinimum, Mode=TwoWay}"
                                                         MaximumIncrementingValue="{Binding MaximumPolyhedronSize}"
                                                         MinimumIncrementingValue="{Binding MinimumPolyhedronSize}" />
                <incrementingControl:IncrementingTextBox Grid.Row="0"
                                                         Grid.Column="1"
                                                         InCompactMode="True"
                                                         IncrementingStep="{Binding UserInterfaceConstants.MediumIncrementingStep, Source={StaticResource ServiceLocator}}"
                                                         IncrementingValue="{Binding PolyhedronAnimationHeightMaximum, Mode=TwoWay}"
                                                         MaximumIncrementingValue="{Binding MaximumPolyhedronSize}"
                                                         MinimumIncrementingValue="{Binding MinimumPolyhedronSize}" />
            </Grid>
            <TextBlock Text="Turn around own axes x; y; z per frame, degrees:" />
            <Grid ColumnSpacing="10" RowSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <incrementingControl:IncrementingTextBox Grid.Row="0"
                                                         Grid.Column="0"
                                                         InCompactMode="True"
                                                         IncrementingStep="{Binding UserInterfaceConstants.LargeIncrementingStep, Source={StaticResource ServiceLocator}}"
                                                         IncrementingValue="{Binding PolyhedronAnimationRotationStepX, Mode=TwoWay}"
                                                         MaximumIncrementingValue="{Binding MaximumAnimationRotationStep}"
                                                         MinimumIncrementingValue="{Binding MinimumAnimationRotationStep}" />
                <incrementingControl:IncrementingTextBox Grid.Row="0"
                                                         Grid.Column="1"
                                                         InCompactMode="True"
                                                         IncrementingStep="{Binding UserInterfaceConstants.LargeIncrementingStep, Source={StaticResource ServiceLocator}}"
                                                         IncrementingValue="{Binding PolyhedronAnimationRotationStepY, Mode=TwoWay}"
                                                         MaximumIncrementingValue="{Binding MaximumAnimationRotationStep}"
                                                         MinimumIncrementingValue="{Binding MinimumAnimationRotationStep}" />
                <incrementingControl:IncrementingTextBox Grid.Row="0"
                                                         Grid.Column="2"
                                                         InCompactMode="True"
                                                         IncrementingStep="{Binding UserInterfaceConstants.LargeIncrementingStep, Source={StaticResource ServiceLocator}}"
                                                         IncrementingValue="{Binding PolyhedronAnimationRotationStepZ, Mode=TwoWay}"
                                                         MaximumIncrementingValue="{Binding MaximumAnimationRotationStep}"
                                                         MinimumIncrementingValue="{Binding MinimumAnimationRotationStep}" />
            </Grid>
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0"
                        HorizontalAlignment="Stretch"
                        Command="{Binding StartPolyhedronAnimationCommand}"
                        Content="Start"
                        IsEnabled="{Binding IsPolyhedronAnimationRunning, Converter={StaticResource CommunityToolkit.BoolNegationConverter}}" />
                <Button Grid.Column="1"
                        HorizontalAlignment="Stretch"
                        Command="{Binding PausePolyhedronAnimationCommand}"
                        Content="Pause"
                        IsEnabled="{Binding IsPolyhedronAnimationRunning}" />
                <Button Grid.Column="2"
                        HorizontalAlignment="Stretch"
                        Command="{Binding ResetPolyhedronAnimationCommand}"
                        Content="Reset" />
            </Grid>

            <!--  Projection  -->
            <TextBlock FontWeight="SemiBold" Text="Projection parameters" />
            <TextBlock Text="Centers of projection xs; ys; zs, cm:" />
            <Grid ColumnSpacing="10" RowSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <incrementingControl:IncrementingTextBox Grid.Row="0"
                                                         Grid.Column="0"
                                                         InCompactMode="True"
                                                         IncrementingStep="{Binding UserInterfaceConstants.LargeIncrementingStep, Source={StaticResource ServiceLocator}}"
                                                         IncrementingValue="{Binding ProjectionCenterX, Mode=TwoWay}"
                                                         MaximumIncrementingValue="{Binding MaximumProjectionCenter}"
                                                         MinimumIncrementingValue="{Binding MinimumProjectionCenter}" />
                <incrementingControl:IncrementingTextBox Grid.Row="0"
                                                         Grid.Column="1"
                                                         InCompactMode="True"
                                                         IncrementingStep="{Binding UserInterfaceConstants.LargeIncrementingStep, Source={StaticResource ServiceLocator}}"
                                                         IncrementingValue="{Binding ProjectionCenterY, Mode=TwoWay}"
                                                         MaximumIncrementingValue="{Binding MaximumProjectionCenter}"
                                                         MinimumIncrementingValue="{Binding MinimumProjectionCenter}" />
                <incrementingControl:IncrementingTextBox Grid.Row="0"
                                                         Grid.Column="2"
                                                         InCompactMode="True"
                                                         IncrementingStep="{Binding UserInterfaceConstants.LargeIncrementingStep, Source={StaticResource ServiceLocator}}"
                                                         IncrementingValue="{Binding ProjectionCenterZ, Mode=TwoWay}"
                                                         MaximumIncrementingValue="{Binding MaximumProjectionCenter}"
                                                         MinimumIncrementingValue="{Binding MinimumProjectionCenter}" />
            </Grid>
            <TextBlock FontFamily="Consolas"
                       Text="{Binding ProjectionMatrixText}"
                       TextWrapping="NoWrap" />
            <TextBlock Text="{Binding VanishingPointsText}" TextWrapping="Wrap" />
            <CheckBox Content="Show vanishing points" IsChecked="{Binding VanishingPointsVisible, Mode=TwoWay}" />
            <Button HorizontalAlignment="Stretch"
                    Command="{Binding ResetProjectionCommand}"
                    Content="Reset projection" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
