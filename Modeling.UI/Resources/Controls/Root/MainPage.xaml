<?xml version="1.0" encoding="utf-8" ?>
<UserControl x:Class="Modeling.UI.Resources.Controls.Root.MainPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="using:Modeling.UI.Behaviors"
             xmlns:controls="using:Modeling.UI.Resources.Controls.Canvas"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:interactivity="using:Microsoft.Xaml.Interactivity"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:media="using:CommunityToolkit.WinUI.Media"
             behaviors:ViewModelsInitializationBehavior.IsDrawingViewModelInitializationEnabled="{Binding DrawingViewModel.InitializeCommand, Source={StaticResource ServiceLocator}}"
             behaviors:ViewModelsInitializationBehavior.IsNavigationViewModelInitializationEnabled="{Binding NavigationViewModel.InitializeCommand, Source={StaticResource ServiceLocator}}"
             behaviors:ViewModelsInitializationBehavior.IsSettingsViewModelInitializationEnabled="{Binding SettingsViewModel.InitializeCommand, Source={StaticResource ServiceLocator}}"
             DataContext="{Binding DrawingViewModel, Source={StaticResource ServiceLocator}}"
             mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <NavigationView Grid.Row="1"
                        Grid.ColumnSpan="2"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        MenuItemsSource="{Binding NavigationViewModel.NavigationItems, Source={StaticResource ServiceLocator}}"
                        PaneDisplayMode="Top"
                        SelectedItem="{Binding NavigationViewModel.SelectedNavigationItem, Source={StaticResource ServiceLocator}, Mode=TwoWay}">
            <NavigationView.MenuItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding ItemName}" />
                </DataTemplate>
            </NavigationView.MenuItemTemplate>
        </NavigationView>

        <controls:Win2DCanvas Grid.Row="2"
                              Grid.Column="0"
                              Margin="0,0,15,15"
                              HorizontalAlignment="Center"
                              Initialize="{Binding InitializeCanvasCommand}"
                              PointerMovedCommand="{Binding CanvasPointerMovedCommand}"
                              PointerPressedCommand="{Binding CanvasPointerPressedCommand}"
                              PointerReleasedCommand="{Binding CanvasPointerReleasedCommand}" />

        <ContentControl Grid.Row="2"
                        Grid.Column="1"
                        Margin="0,0,15,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Center"
                        Tag="{Binding UserInterfaceConstants.NavigationFrameName, Source={StaticResource ServiceLocator}}" />

        <!--  This grid is used for dialogs  -->
        <Grid x:Name="DialogGrid"
              Grid.ColumnSpan="2"
              Tag="{Binding UserInterfaceConstants.ApplicationPopupRootName, Source={StaticResource ServiceLocator}}"
              Visibility="Collapsed" />
    </Grid>
</UserControl>
