<?xml version="1.0" encoding="utf-8" ?>
<UserControl x:Class="Modeling.UI.Controls.Root.MainPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Modeling.UI.Controls.Canvas"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:interactivity="using:Microsoft.Xaml.Interactivity"
             xmlns:local="using:Modeling.UI.Controls.Root"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <interactivity:Interaction.Behaviors>
        <interactivity:EventTriggerBehavior EventName="Loaded">
            <interactivity:InvokeCommandAction Command="{Binding DrawingViewModel.InitializeCommand, Source={StaticResource ServiceLocator}}" />
        </interactivity:EventTriggerBehavior>
    </interactivity:Interaction.Behaviors>

    <controls:Win2DCanvas />
</UserControl>
